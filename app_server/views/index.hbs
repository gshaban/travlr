<div id="background">
  <div id="page">
    {{> header }}
    <div id="contents">
      <div class="box">
        <div>
          <div class="body">
            <h1>{{pageTitle}}</h1>
            <div id="main">
              <h2>{{pageHeading}}</h2>
              <p>{{pageText}}</p>
              {{#if pageLink}}
                <p><a href="{{pageLink}}">{{pageLinkText}}</a></p>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{> footer }}
</div>
