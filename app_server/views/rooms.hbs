<div id="background">
  <div id="page">
    {{> header }}
    <div id="contents">
      <div class="box">
        <div>
          <div class="body">
            <h1>Rooms</h1>
            <ul id="rooms">
              <li>
                <img src="/images/first-class.jpg" alt="First class room">
                <h2>First Class Room</h2>
                <p>
                  Relax in a comfortable room prepared for Travlr Getaways guests
                  who want a quiet place to recharge after a day of travel.
                </p>
                <span class="rate">$220 / Night</span>
              </li>
              <li>
                <img src="/images/deluxe.jpg" alt="Deluxe room">
                <h2>Deluxe Room</h2>
                <p>
                  Enjoy extra space, resort views, and convenient access to
                  beach and dining areas during your stay.
                </p>
                <span class="rate">$280 / Night</span>
              </li>
              <li>
                <img src="/images/suite.jpg" alt="Suite room">
                <h2>Suite</h2>
                <p>
                  The suite option gives travelers a larger room layout and a
                  premium resort experience for longer getaways.
                </p>
                <span class="rate">$350 / Night</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{> footer }}
</div>
