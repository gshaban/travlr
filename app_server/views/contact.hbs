<div id="background">
  <div id="page">
    {{> header }}
    <div id="contents">
      <div class="box">
        <div>
          <div id="contact" class="body">
            <h1>Contact</h1>
            <form>
              <table>
                <tr>
                  <td>Name:</td>
                  <td><input type="text" name="name"></td>
                </tr>
                <tr>
                  <td>Email:</td>
                  <td><input type="email" name="email"></td>
                </tr>
                <tr>
                  <td class="txtarea">Message:</td>
                  <td><textarea name="message"></textarea></td>
                </tr>
                <tr>
                  <td></td>
                  <td><input type="button" class="btn" value=""></td>
                </tr>
              </table>
            </form>
            <p>
              <span>Travlr Getaways</span>
              Contact our travel agency team for trip package questions,
              destination support, and reservation planning.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{> footer }}
</div>
